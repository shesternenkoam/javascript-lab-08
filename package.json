{
  "name": "dogfight-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "lint": "biome lint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build:client": "npm run build -w client",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "e2e": "playwright test",
    "load-test": "node server/load-test.ts",
    "bench": "node shared/test/bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
