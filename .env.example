# Server Network & Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security & Origins
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate & Capacity Limits
MAX_CONNECTIONS_PER_IP=10
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=10

# Observability
LOG_LEVEL=info
GIT_SHA=dev
